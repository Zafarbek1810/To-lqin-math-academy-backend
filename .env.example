# ── PostgreSQL ────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=tolqin
# Jadval sxemasini avtomatik yangilash. Production da: false
# (birinchi ishga tushirishda jadvallarni yaratish uchun bir marta true qilinadi)
DB_SYNC=true
# Boshqariladigan (managed) baza uchun SSL: true
DB_SSL=false

# ── API ───────────────────────────────────────────────────────
PORT=3000
# Production da nginx orqali ishlaydi — tashqi tarmoqqa ochilmasin:
# HOST=127.0.0.1
HOST=0.0.0.0
# Kamida 32 belgi. Yangi kalit: openssl rand -hex 32
JWT_SECRET=tolqin-math-dev-secret-change-me
JWT_EXPIRES_IN=7d
# Ruxsat etilgan frontend domenlari (vergul bilan). Bo'sh = faqat same-origin.
# CORS_ORIGINS=https://dashboard.example.uz,https://example.uz

# ── Seed (faqat bo'sh baza) ───────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_NAME=Administrator
ADMIN_PASSWORD=123
